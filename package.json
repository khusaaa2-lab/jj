{
  "name": "serenity-school",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive Serenity school concept with a procedural Three.js campus",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "start": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "check": "node --test tests/*.test.js",
    "check:browser": "playwright test",
    "capture:scenes": "node scripts/capture-scenes.mjs",
    "capture:review": "node scripts/capture-review.mjs",
    "package:production": "npm run build && node scripts/package-production.mjs",
    "package:single": "node scripts/package-single.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "vite": "7.3.7"
  }
}
